#!/usr/bin/env bash
set -euo pipefail

raiz="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$raiz"

readonly PHP=phparrot-php
readonly NODE=phparrot-node
readonly AGENDA=phparrot-agenda

passo() { printf '\n==> %s\n' "$*"; }
info() { printf '    %s\n' "$*"; }
aviso() { printf '    ! %s\n' "$*"; }
falha() {
    printf '\nErro: %s\n' "$*" >&2
    exit 1
}

exigir() {
    command -v "$1" >/dev/null 2>&1 || falha "$1 não encontrado. $2"
}

rodando() {
    [ "$(docker inspect -f '{{.State.Running}}' "$1" 2>/dev/null)" = true ]
}

no_php() { docker exec "$PHP" "$@"; }
no_node() { docker exec "$NODE" "$@"; }

ajuda() {
    cat <<'TEXTO'
Uso: bin/phparrot <comando> [dev|prod]

  setup   Sobe tudo do zero ou confere o que já existe: .env, containers,
          dependências, chave, banco e assets. Pode rodar de novo quando quiser.
          O ambiente padrão é dev. Em prod: sem o phparrot-node, nginx só em
          127.0.0.1, composer sem dev, caches do Laravel e assets já construídos.
  assets  Só o build do front para prod: um docker run --rm com a imagem node
          do Terraform grava public/build e não deixa container ligado. Pula o
          build se resources/, os lockfiles e o vite.config.js não mudaram.
  dev     Vite com recarga no phparrot-node e os logs do Laravel (pail) no
          phparrot-php. Ctrl+C para os dois.
  contrato-gateway
          Extrai o openapi.json da imagem do gateway fixada em
          docker/gateway/Dockerfile para storage/app/private/gateway/. O teste
          de contrato (tests/Feature/ContratoDoGatewayTest.php) lê esse arquivo.
          Rode de novo quando o FROM mudar.
TEXTO
}

terraform_aplicar() {
    local plano saida codigo resumo destruir
    plano="$(mktemp)"
    terraform -chdir=terraform init -input=false >/dev/null

    set +e
    saida="$(terraform -chdir=terraform plan -input=false -no-color -detailed-exitcode -out="$plano" 2>&1)"
    codigo=$?
    set -e

    case "$codigo" in
        0)
            info "Nada a mudar: os containers já estão como o Terraform descreve."
            ;;
        2)
            resumo="$(printf '%s\n' "$saida" | grep -E '^Plan: ' || true)"
            destruir="$(printf '%s\n' "$resumo" | sed -nE 's/.* ([0-9]+) to destroy.*/\1/p')"
            info "${resumo:-Plano com mudanças.}"
            if [ "${destruir:-0}" != 0 ]; then
                rm -f "$plano"
                falha "o plano destrói ou recria recursos. Revise com 'terraform -chdir=terraform plan' e aplique à mão."
            fi
            terraform -chdir=terraform apply -input=false -no-color "$plano" | grep -E '^Apply complete' || true
            ;;
        *)
            rm -f "$plano"
            printf '%s\n' "$saida" >&2
            falha "o terraform plan falhou."
            ;;
    esac

    rm -f "$plano"
}

imagem_node() {
    sed -nE 's/^[[:space:]]*name[[:space:]]*=[[:space:]]*"(node:[^"]+)".*/\1/p' terraform/main.tf | head -n 1
}

hash_do_front() {
    {
        find resources -type f -print0 | sort -z | xargs -0 sha256sum
        sha256sum package.json package-lock.json vite.config.js composer.lock
    } | sha256sum | cut -d' ' -f1
}

construir_assets() {
    local imagem atual guardado
    imagem="$(imagem_node)"
    [ -n "$imagem" ] || falha "não achei a imagem node em terraform/main.tf."
    atual="$(hash_do_front)"
    guardado="$(cat public/build/fonte.sha256 2>/dev/null || true)"

    if [ -f public/build/manifest.json ] && [ "$atual" = "$guardado" ]; then
        info "Assets em dia: o front não mudou desde o último build."
        return
    fi

    mkdir -p public/build node_modules
    docker run --rm \
        --user "$(id -u):$(id -g)" \
        -e HOME=/tmp -e npm_config_cache=/tmp/npm -e npm_config_update_notifier=false \
        -v "$raiz:/app:ro" \
        -v "$raiz/public/build:/app/public/build" \
        --tmpfs "/app/node_modules:rw,exec,uid=$(id -u),gid=$(id -g),size=1g" \
        -w /app \
        "$imagem" \
        sh -c 'npm ci --no-audit --no-fund --loglevel=error && npm run build --silent' >/dev/null \
        || falha "o build dos assets falhou."
    [ -f public/build/manifest.json ] || falha "o build terminou sem public/build/manifest.json."
    printf '%s\n' "$atual" >public/build/fonte.sha256
    info "Assets construídos com $imagem, num container que já foi removido."
}

assets() {
    fora_do_container
    exigir docker "Instale o Docker."
    passo "Assets do front (build isolado)"
    construir_assets
}

imagem_do_gateway() {
    sed -nE 's/^FROM[[:space:]]+([^[:space:]]+).*/\1/p' docker/gateway/Dockerfile | head -n 1
}

extrair_contrato_do_gateway() {
    local imagem destino
    imagem="$(imagem_do_gateway)"
    [ -n "$imagem" ] || falha "não achei o FROM em docker/gateway/Dockerfile."
    destino=storage/app/private/gateway

    if [ -s "$destino/openapi.json" ] && [ "$(cat "$destino/openapi.imagem" 2>/dev/null || true)" = "$imagem" ]; then
        info "Contrato do gateway em dia: $imagem."
        return
    fi

    mkdir -p "$destino"
    docker run --rm --entrypoint cat "$imagem" /app/openapi.json >"$destino/openapi.json.novo" \
        || { rm -f "$destino/openapi.json.novo"; falha "não consegui extrair o /app/openapi.json de $imagem."; }
    mv "$destino/openapi.json.novo" "$destino/openapi.json"
    printf '%s\n' "$imagem" >"$destino/openapi.imagem"
    info "Contrato do gateway extraído de $imagem para $destino/openapi.json."
}

contrato_gateway() {
    fora_do_container
    exigir docker "Instale o Docker."
    passo "Contrato do gateway (openapi.json da imagem fixada)"
    extrair_contrato_do_gateway
}

exigir_producao() {
    local sobre
    sobre="$(no_php php artisan about --only=environment --json)"
    printf '%s' "$sobre" | grep -q '"environment":"production"' || falha "em prod, o .env precisa de APP_ENV=production."
    printf '%s' "$sobre" | grep -q '"debug_mode":false' || falha "em prod, o .env precisa de APP_DEBUG=false."
    info "APP_ENV=production e APP_DEBUG=false, lidos do .env."
}

fora_do_container() {
    [ ! -f /.dockerenv ] || falha "rode bin/phparrot no host (no WSL), não dentro de um container: ele usa o Docker e o Terraform da máquina."
}

setup() {
    local ambiente="${1:-dev}"
    case "$ambiente" in
        dev | prod) ;;
        *) falha "ambiente '$ambiente' desconhecido. Use dev ou prod." ;;
    esac
    export TF_VAR_ambiente="$ambiente"
    fora_do_container
    exigir docker "Instale o Docker (no Windows, o Docker Desktop integrado ao WSL2)."
    exigir terraform "Instale o Terraform 1.3 ou superior."
    docker info >/dev/null 2>&1 || falha "o Docker não respondeu. Ele está ligado?"
    [ "$(id -u)" = 1000 ] || aviso "Os containers rodam com o UID 1000, e o seu é $(id -u). Arquivos criados por eles podem ficar sem permissão para você."

    passo ".env"
    if [ -f .env ]; then
        info "Já existe e não foi tocado."
    else
        cp .env.example .env
        info "Criado a partir do .env.example."
    fi

    passo "Containers (Terraform, ambiente $ambiente)"
    terraform_aplicar
    local containers=("$PHP")
    [ "$ambiente" = dev ] && containers+=("$NODE")
    for container in "${containers[@]}"; do
        rodando "$container" || falha "o container $container não está rodando."
    done

    if [ "$ambiente" = prod ]; then
        passo "Dependências do PHP (composer install --no-dev)"
        no_php composer install --no-interaction --no-progress --quiet --no-dev --optimize-autoloader
        exigir_producao
    else
        passo "Dependências do PHP (composer install)"
        no_php composer install --no-interaction --no-progress --quiet
    fi
    info "Prontas."

    if [ "$ambiente" = dev ]; then
        passo "Contrato do gateway (openapi.json da imagem fixada)"
        extrair_contrato_do_gateway
    fi

    passo "Chave do app e banco"
    local estado chave fila
    estado="$(no_php php artisan tinker --execute='echo (blank(config("app.key")) ? "vazia" : "ok")." ".config("queue.default");')"
    read -r chave fila <<<"$estado"
    if [ "$chave" = vazia ]; then
        no_php php artisan key:generate --force --no-interaction >/dev/null
        info "APP_KEY gerada."
    else
        info "APP_KEY já existe e foi mantida."
    fi
    [ -f database/database.sqlite ] || touch database/database.sqlite
    no_php php artisan migrate --force --no-interaction | grep -v '^\s*$' | sed 's/^ */    /'

    if [ "$ambiente" = prod ]; then
        passo "Caches do Laravel e assets"
        for cache in config route view; do
            no_php php artisan "${cache}:cache" --no-interaction >/dev/null
        done
        info "config:cache, route:cache e view:cache prontos."
        construir_assets
    else
        passo "Dependências do JavaScript e assets (phparrot-node)"
        for cache in config route view; do
            no_php php artisan "${cache}:clear" --no-interaction >/dev/null
        done
        no_node npm ci --no-audit --no-fund --silent
        no_node npm run build --silent >/dev/null
        info "node_modules pelo npm ci e assets em public/build."
    fi

    if ! rodando "$AGENDA"; then
        docker start "$AGENDA" >/dev/null
        info "Agenda ($AGENDA) iniciada."
    fi

    passo "Conferência"
    local url status
    url="$(terraform -chdir=terraform output -raw app_url)"
    if command -v curl >/dev/null 2>&1; then
        status="$(curl -s -o /dev/null -w '%{http_code}' "$url/" || true)"
        [ "$status" = 200 ] || falha "$url/ respondeu $status."
        info "$url respondeu 200."
    else
        info "Abra $url no navegador."
    fi

    if [ "$fila" != sync ]; then
        aviso "A fila está configurada como '$fila', mas o app não usa fila. Ponha QUEUE_CONNECTION=sync no .env."
    fi
    info "Opcional no .env: GOOGLE_TRANSLATE_KEY (tradução pelo Google) e PHPARROT_TOKEN (gestão de textos; gere com 'openssl rand -hex 32')."
    info "Depois de mudar o .env: docker exec $PHP php artisan config:clear"
    printf '\nPronto: %s\n' "$url"
}

parar_dev() {
    trap - EXIT INT TERM
    no_node pkill -INT -f vite >/dev/null 2>&1 || true
    no_php php -r 'foreach (glob("/proc/[0-9]*/cmdline") ?: [] as $f) { $pid = (int) basename(dirname($f)); $linha = (string) @file_get_contents($f); if ($pid !== getmypid() && (str_contains($linha, "artisan\0pail") || str_contains($linha, "/storage/pail/"))) { posix_kill($pid, 15); } }' || true
    kill "${vite:-}" "${logs:-}" >/dev/null 2>&1 || true
    sleep 1
    no_node pgrep -f vite >/dev/null 2>&1 || rm -f public/hot
}

dev() {
    fora_do_container
    exigir docker "Instale o Docker."
    for container in "$PHP" "$NODE"; do
        rodando "$container" || falha "o container $container não está rodando. Rode bin/phparrot setup antes."
    done
    if no_node pgrep -f vite >/dev/null 2>&1; then
        falha "o Vite já está rodando no $NODE."
    fi

    local terminal=-i
    [ -t 0 ] && [ -t 1 ] && terminal=-it

    trap parar_dev EXIT
    trap 'parar_dev; exit 130' INT TERM
    printf 'Vite em http://localhost:%s (recarga) e logs do Laravel abaixo. Ctrl+C para parar.\n\n' "$(no_node printenv VITE_HOST_PORT || echo 5174)"
    no_php php artisan pail --timeout=0 &
    logs=$!
    docker exec "$terminal" "$NODE" npm run dev <&0 &
    vite=$!
    wait "$vite"
}

case "${1:-}" in
    setup) setup "${2:-dev}" ;;
    assets) assets ;;
    dev) dev ;;
    contrato-gateway) contrato_gateway ;;
    -h | --help | help | '') ajuda ;;
    *)
        ajuda >&2
        exit 1
        ;;
esac
